# PostgreSQL connection string (required).
DATABASE_URL=postgres://nextbudget:nextbudget@localhost:5432/nextbudget

# Timezone used for date formatting (optional).
TZ=Europe/Paris

# First-run login for the owner, read by `npm run db:migrate` (optional).
# Without them the app starts in open mode: no login, everything resolves to a
# single owner — fine on a laptop, less so on a LAN. Setting a password here
# switches auth to `enforced` on the first migrate. They are read only while
# the owner has no password yet; afterwards use `npm run auth:reset`.
# NEXTBUDGET_OWNER_NAME=Propriétaire
# NEXTBUDGET_OWNER_EMAIL=vous@example.com
# NEXTBUDGET_OWNER_PASSWORD=au-moins-8-caracteres
