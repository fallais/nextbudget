# PostgreSQL connection string (required).
DATABASE_URL=postgres://banquejs:banquejs@localhost:5432/banquejs

# Timezone used for date formatting (optional).
TZ=Europe/Paris

# Extra categorization pattern packs (optional): comma-separated YAML file or
# directory paths, or installed package directories. Loaded at runtime as a
# fallback layer below your own rules. Use this for private/personal packs
# (e.g. patterns.personal.local.yaml) and the SaaS "premium" pack.
# PATTERN_PACKS=./patterns.personal.local.yaml
